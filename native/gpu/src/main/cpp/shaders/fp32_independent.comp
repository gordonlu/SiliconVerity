#version 450

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) buffer IOBuffer {
    float data[];
};

layout(push_constant) uniform Push {
    uint iterations;
    float factorA, offsetA;
    float factorB, offsetB;
    float factorC, offsetC;
    float factorD, offsetD;
    uint vec4Count;
} pc;

void main() {
    uint base = gl_GlobalInvocationID.x;
    if (base >= pc.vec4Count) return;
    uint i = base * 4u;
    // 4 条独立链, 各用不同 factor/offset (防代数合并)
    vec4 a = vec4(data[i], data[i + 1u], data[i + 2u], data[i + 3u]);
    vec4 b = a + vec4(1.0);
    vec4 c = a + vec4(2.0);
    vec4 d = a + vec4(3.0);
    for (uint k = 0u; k < pc.iterations; ++k) {
        a = a * pc.factorA + pc.offsetA;
        b = b * pc.factorB + pc.offsetB;
        c = c * pc.factorC + pc.offsetC;
        d = d * pc.factorD + pc.offsetD;
    }
    // 跨 dispatch 作为下一轮输入时保持数值尺度；直接求和会每轮约 x4，
    // 多 dispatch saturation 协议下会快速溢出。该循环外归一化开销不计入 FMA FLOP。
    vec4 sum = (a + b + c + d) * 0.25;
    data[i]      = sum.x;
    data[i + 1u] = sum.y;
    data[i + 2u] = sum.z;
    data[i + 3u] = sum.w;
}
