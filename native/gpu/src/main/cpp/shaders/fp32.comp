#version 450

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) buffer IOBuffer {
    float data[];
};

layout(push_constant) uniform Push {
    uint iterations;
    float factorA, offsetA;
    float factorB, offsetB;
    float factorC, offsetC;
    float factorD, offsetD;
    uint vec4Count;
} pc;

void main() {
    uint base = gl_GlobalInvocationID.x;
    if (base >= pc.vec4Count) return;
    uint i = base * 4u;
    vec4 v = vec4(data[i], data[i + 1u], data[i + 2u], data[i + 3u]);
    // dependency: 单条依赖链 (仅用 factorA/offsetA)
    for (uint k = 0u; k < pc.iterations; ++k) {
        v = v * pc.factorA + pc.offsetA;
    }
    data[i]     = v.x;
    data[i + 1u] = v.y;
    data[i + 2u] = v.z;
    data[i + 3u] = v.w;
}
